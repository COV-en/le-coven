# Public read API used by the homepage (never put an API token here).
PUBLIC_STRAPI_URL=....
# Exact nomSite of the published Site Settings entry.
PUBLIC_STRAPI_SITE_NAME=Blue Moon
# Public links used by the static navigation and footer.
PUBLIC_COVEN_URL=.....
# Canonical public URL of this Blue Moon deployment (no trailing slash).
PUBLIC_SITE_URL=https://blue-moon.lecoven.fr
PUBLIC_TICKETING_URL=.....
PUBLIC_VOLUNTEER_URL=.....
