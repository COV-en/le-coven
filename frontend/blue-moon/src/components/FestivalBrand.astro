---
const { href = "/" } = Astro.props;
---

<a class="brand" href={href}>
  <img src="/images/logo-le-coven-v2.png" alt="" width="42" height="42" />
  <span class="brand-copy">
    <span>
      <strong>BLUE MOON</strong>
      <small>Festival</small>
    </span>
  </span>
</a>

<style>
  .brand {
    flex-shrink: 1;
    min-width: 0;
  }

  .brand img {
    flex: none;
    object-fit: contain;
  }

  .brand-copy > span {
    white-space: nowrap;
  }

</style>
